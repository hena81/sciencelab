
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler" />
    </handlers>

    <httpPlatform
      processPath="node"
      arguments="server.js"
      startupTimeLimit="20"
      startupRetryCount="2"
      stdoutLogEnabled="true"
      stdoutLogFile="./logs/node-log.txt">

      <environmentVariables>
        <environmentVariable
          name="PORT"
          value="%HTTP_PLATFORM_PORT%" />

        <environmentVariable
          name="NODE_ENV"
          value="production" />
      </environmentVariables>

    </httpPlatform>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
